<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.groupcontrol.signalspoof">

    <application
        android:allowBackup="false"
        android:label="Signal Spoof"
        android:supportsRtl="true">

        <!-- Xposed module metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Spoofs baseband version, cell info, signal strength, SIM state, phone number, IMSI, and IMEI for group control." />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
