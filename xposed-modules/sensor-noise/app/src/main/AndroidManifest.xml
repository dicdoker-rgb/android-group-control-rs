<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.groupcontrol.sensornoise">

    <application
        android:allowBackup="false"
        android:label="Sensor Noise"
        android:supportsRtl="true">

        <!-- Xposed module metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Injects white noise into sensor readings, fakes battery temperature and level, and ensures a complete sensor list for group control." />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
