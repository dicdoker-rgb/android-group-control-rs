{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "群控主板",
  "version": "0.1.0",
  "identifier": "com.showme.android-group-control",
  "build": {
    "beforeDevCommand": "cd .. && ./scripts/tauri-dev.sh",
    "beforeBuildCommand": "cd .. && ./scripts/prepare-tauri-sidecar.sh release && cd frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "群控主板",
        "width": 1680,
        "height": 1040,
        "minWidth": 1280,
        "minHeight": 820,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/web"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
